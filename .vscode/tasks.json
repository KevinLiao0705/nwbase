{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Maven: clean package",
      "type": "shell",
      "command": "mvn",
      "args": [
        "clean",
        "package"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
