{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "compile server.java",
      "type": "shell",
      "command": "javac",
      "args": [
        "--release",
        "11",
        "-g",
        "-encoding",
        "UTF-8",
        "-d",
        "target/classes",
        "-cp",
        ".libs/sqlite-jdbc-3.34.0.jar",
        "src/main/java/server.java"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$javac"]
    },
    {
      "label": "clean and package",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/package.ps1"
      ],
      "group": "build",
      "problemMatcher": ["$javac"],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    }
  ]
}
